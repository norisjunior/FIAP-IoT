    "z": "172491b9e0590118",
    "name": "Campos e tags",
    "func": "// device sai dos campos e vira tag. Mandar nos dois lugares e conflito de schema.\nconst {device, ...campos} = msg.payload;\nmsg.payload = [campos, {device}];\nreturn msg;",
