; Renomeie este arquivo para "platformio.ini" ao usar o ESP32-S3 Super Mini.
; Guarde o original como "platformio.ini.esp32dev".
;
; O codigo em src/ NAO muda: a flag PLACA_S3 troca os pinos do INMP441
; (SCK 4, WS 5, SD 6 em vez de 26, 25, 33) dentro do INMP441.hpp.

[env:esp32s3]
platform = espressif32@6.12.0
framework = arduino
board = esp32-s3-devkitc-1
board_upload.flash_size = 4MB
board_build.partitions = default.csv
monitor_speed = 921600
build_flags =
    -DARDUINO_USB_CDC_ON_BOOT=1
    -DPLACA_S3
