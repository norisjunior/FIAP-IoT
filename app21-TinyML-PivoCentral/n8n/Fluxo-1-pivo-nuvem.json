    {
      "parameters": {
        "jsCode": "// A ordem da nuvem: desligar. Na bomba, ela vale por 2 h.\nconst chuva = String($input.first().json.chuva_mm).replace(\".\", \",\");\n\nreturn [{\n  json: {\n    dispositivo: \"nuvem\",\n    bomba: false,\n    motivo: `chuva prevista: ${chuva} mm em 2 h`\n  }\n}];\n"
