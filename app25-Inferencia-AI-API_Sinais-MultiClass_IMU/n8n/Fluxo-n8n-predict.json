    {
      "parameters": {
        "jsCode": "// So avisa uma pessoa na VIRADA para anomalia.\n//\n// O ESP32 quer a classe a cada segundo -- e por isso o no de MQTT fica no\n// ramo de cima, sempre. Uma pessoa nao: sem este filtro seriam 60 mensagens\n// por minuto enquanto a anomalia durasse, e o bot do Telegram seria\n// limitado. A cadencia do CONTROLE nao e a cadencia do ALERTA.\n//\n// $getWorkflowStaticData guarda um valor entre execucoes do fluxo.\nconst estado   = $getWorkflowStaticData('global');\nconst atual    = $input.first().json.class;\nconst anterior = estado.ultimaClasse;\nestado.ultimaClasse = atual;\n\nif (atual === 'anomalia' && anterior !== 'anomalia') {\n    return [{ json: { anterior: anterior || 'nenhuma' } }];\n}\n\nreturn [];   // nada a enviar: o ramo do Telegram para aqui\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "id": "a1f4c2d7-8b31-4e05-9c62-1d7ae930f006",
      "name": "So na virada para anomalia"
    },
