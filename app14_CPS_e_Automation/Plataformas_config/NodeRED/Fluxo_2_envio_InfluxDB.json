  {
    "id": "9f231a9269382228",
    "type": "function",
    "z": "172491b9e0590116",
    "name": "Condição da entrega",
    "func": "const p = msg.payload;\nconst LIMIAR_TEMP = 30;\nconst LIMIAR_UMID = 70;\nconst LIMIAR_DIST = 25;\nconst LIMIAR_MOVIMENTACAO = 3;   // m/s2. Limite depende do contexto:\n// caixa em prateleira aceita pouco; bag de entregador em moto passa disso na rua ruim.\n\nlet motivos = [];\nif (![p.temp, p.umid, p.dist, p.movimentacao].every(Number.isFinite)) motivos.push(\"Falha de sensor\");\nif (Number.isFinite(p.temp) && p.temp > LIMIAR_TEMP) motivos.push(\"Temperatura alta\");\nif (Number.isFinite(p.umid) && p.umid > LIMIAR_UMID) motivos.push(\"Umidade alta\");\nif (Number.isFinite(p.dist) && p.dist > LIMIAR_DIST) motivos.push(\"Tampa aberta\");\nif (Number.isFinite(p.movimentacao) && p.movimentacao > LIMIAR_MOVIMENTACAO) motivos.push(\"Movimentação brusca\");\nmsg.payload = {...p, motivos, alerta: motivos.length > 0, estado: motivos.join(\" / \") || \"Entrega em condição normal\"};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 160,
    "wires": [
      [
        "251a77501923e84f"
      ]
    ]
  },
  {
    "id": "251a77501923e84f",
    "type": "function",
    "z": "172491b9e0590116",
    "name": "Campos e tags",
    "func": "const p = msg.payload;\nlet campos = {alerta: p.alerta};\nfor (const nome of [\"temp\", \"umid\", \"dist\", \"movimentacao\", \"accel_x\", \"accel_y\", \"accel_z\"]) {\n    if (Number.isFinite(p[nome])) campos[nome] = p[nome];\n}\nmsg.payload = [campos, {device: p.device}];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
