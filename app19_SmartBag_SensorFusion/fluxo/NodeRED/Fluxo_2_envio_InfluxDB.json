  {
    "id": "sb19fn",
    "type": "function",
    "z": "sb19tab",
    "g": "sb19grp",
    "name": "Preparar para o InfluxDB",
    "func": "const p = msg.payload;\nconst campos = {};\nconst features = [\"temperatura\", \"umidade\", \"delta_distancia\", \"luz\", \"mov_max\", \"incl_max\"];\n// Campos null ficam ausentes no InfluxDB.\nfeatures.forEach(c => {\n    if (typeof p[c] === \"number\" && Number.isFinite(p[c])) campos[c] = p[c];\n});\nconst tags = {device: p.device, rodada: String(p.rodada), situacao: p.situacao};\nmsg.payload = [campos, tags];\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
    "wires": [
      [
        "sb19out",
        "sb19dbg"
      ]
    ]
