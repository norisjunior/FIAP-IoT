      "name": "Previsao de chuva"
    },
    {
      "parameters": {
        "jsCode": "// A previsao hora a hora: a hora atual e a proxima (forecast_hours = 2).\nconst previsao = $input.first().json.hourly || {};\nconst mm = previsao.precipitation || [];\nlet chuva_mm = mm.reduce((soma, valor) => soma + (valor || 0), 0);\n\n// Para a demonstracao: troque null por um numero (ex.: 25) e a nuvem age como\n// se fosse chover isso nas proximas 2 h. Depois, volte para null.\nconst SIMULAR_MM = null;\nif (SIMULAR_MM !== null) chuva_mm = SIMULAR_MM;\n\nconst LIMITE_MM = 10;   // acima disso, a chuva irriga sozinha\n\nreturn [{\n  json: {\n    chuva_mm: Math.round(chuva_mm * 10) / 10,\n    limite_mm: LIMITE_MM,\n    vai_chover: chuva_mm > LIMITE_MM\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        120
      ],
      "id": "7601d27a-e6a7-5537-a448-1f3673919481",
      "name": "Chuva nas proximas 2 h"
    },
