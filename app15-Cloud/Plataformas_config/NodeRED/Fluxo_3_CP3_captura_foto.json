    {
        "id": "c3a0f1e2d4b5a614",
        "type": "function",
        "z": "c3a0f1e2d4b5a601",
        "name": "Nomear foto e registro",
        "func": "// Mesmo nome para os dois arquivos: equipe01_2026-10-06T14-30-00.jpg e .json\n// Hora local: o container roda com TZ=America/Sao_Paulo.\nconst agora = new Date();\nconst local = new Date(agora.getTime() - agora.getTimezoneOffset() * 60000);\nconst hora = local.toISOString().slice(0, 19);\nconst nome = \"equipe01_\" + hora.replace(/:/g, \"-\");\n\nconst foto = {payload: msg.payload, filename: \"/data/files/\" + nome + \".jpg\"};\n\nconst registro = {\n    filename: \"/data/files/\" + nome + \".json\",\n    payload: JSON.stringify({\n        foto: nome + \".jpg\",\n        data_hora: hora,\n        gatilho: \"dist > 25 e movimentacao > 3\",\n        ...msg.evento\n    }, null, 2)\n};\n\nreturn [foto, registro];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 320,
        "wires": [
            [
                "c3a0f1e2d4b5a615"
            ],
            [
                "c3a0f1e2d4b5a615"
            ]
        ]
    },
