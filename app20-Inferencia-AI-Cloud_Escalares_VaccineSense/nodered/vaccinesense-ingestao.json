  {
    "id": "vs18fn",
    "type": "function",
    "z": "vs18tab",
    "g": "vs18grp",
    "name": "Preparar para o InfluxDB",
    "func": "// Node-RED carimba o horario: o InfluxDB usa a hora de gravacao como _time.\n// Por isso o dispositivo nao envia timestamp.\n//\n// Nada aqui precisa ser editado entre rodadas: quem numera a rodada e o botao\n// da caixa. Configure o no InfluxDB uma vez e esqueca este arquivo.\n\nconst p = msg.payload || {};\n\nconst campos = {\n    device: p.device,\n    id: p.id,\n    tempInterna: p.tempInterna,\n    tempExterna: p.tempExterna,\n    umidade: p.umidade,\n    luz: p.luz,\n    criticidade: p.criticidade,\n    distancia: p.distancia,\n    tempoForaDaFaixa: p.tempoForaDaFaixa\n};\n\n// Unica tag: a rodada, que vem do firmware. Tag no InfluxDB e sempre texto.\nconst tags = { rodada: String(p.rodada) };\n\n// O no influxdb out grava [campos, tags] quando recebe um array de 2 objetos.\nmsg.payload = [campos, tags];\n\nnode.warn(\"Rodada \" + p.rodada + \": \" + JSON.stringify(campos));\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
    "wires": [
      [
        "vs18out",
        "vs18dbg"
      ]
    ]
  },
  {
    "id": "vs18out",
    "type": "influxdb out",
    "z": "vs18tab",
    "g": "vs18grp",
    "influxdb": "vs18db",
