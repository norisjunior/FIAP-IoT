    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1) O MQTT Trigger entrega o payload cru em $json.message (string).\n//    Sem este no, o HTTP Request mandaria {message, topic} para a API\n//    e ela responderia 422: nenhuma das 8 features estaria no corpo.\nlet data = $json.message;\nif (typeof data === \"string\") data = JSON.parse(data);\n\n// 2) Monta um objeto \"limpo\" so com as 8 features, usando os MESMOS\n//    nomes do treino (app17-7 / treinamento_multiclasse.ipynb).\n//    device e ts_epoch_ms sao descartados aqui. A API ate os ignoraria\n//    sozinha, mas o filtro explicito e o contrato com o .pkl: se um nome\n//    mudar de um lado, quebra aqui e nao silenciosamente na predicao.\nreturn {\n    json: {\n        mean_ax: data.mean_ax,\n        mean_ay: data.mean_ay,\n        mean_az: data.mean_az,\n        std_ax:  data.std_ax,\n        std_ay:  data.std_ay,\n        std_az:  data.std_az,\n        std_mag: data.std_mag,\n        p2p_mag: data.p2p_mag,\n    }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "a1f4c2d7-8b31-4e05-9c62-1d7ae930f002",
      "name": "Code (gera JSON)"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b7e2f105-4a68-4c39-9d21-3f5c8ab41e77",
              "leftValue": "={{ [\"mean_ax\",\"mean_ay\",\"mean_az\",\"std_ax\",\"std_ay\",\"std_az\",\"std_mag\",\"p2p_mag\"]\n    .every(k => typeof $json[k] === \"number\" && !isNaN($json[k])) \n    .toBoolean() }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
