    {
      "parameters": {
        "jsCode": "// Timestamp e periodo no fuso de Sao Paulo, como no banco do motor.\nconst agora = new Date().toLocaleString(\"sv-SE\", {\n  timeZone: \"America/Sao_Paulo\",\n  hour12: false\n});\n\nconst hora = Number(new Date().toLocaleString(\"en-US\", {\n  timeZone: \"America/Sao_Paulo\",\n  hour: \"numeric\",\n  hour12: false\n}));\n\nlet periodo = \"madrugada\";\nif (hora >= 6 && hora < 12) periodo = \"manhã\";\nelse if (hora >= 12 && hora < 18) periodo = \"tarde\";\nelse if (hora >= 18) periodo = \"noite\";\n\n// O estado vem da propria bomba: ligada ou nao, e quem mandou.\nconst estado = $input.first().json.message;\n\nreturn [{\n  json: {\n    bomba: estado.bomba === true,\n    quem_manda: estado.quem_manda,\n    motivo: estado.motivo || \"\",\n    timestamp_estado: agora,\n    periodo\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "id": "0aad0c48-c8ad-5578-95f3-1c8d03b4134e",
      "name": "Formata para o banco"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS pivo_bomba (\n  id SERIAL PRIMARY KEY,\n  bomba BOOLEAN,              -- true = ligada\n  quem_manda TEXT,            -- pessoa, nuvem, placa ou ninguem\n  motivo TEXT,\n  timestamp_estado TEXT,\n  periodo TEXT,\n  created_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nINSERT INTO pivo_bomba (bomba, quem_manda, motivo, timestamp_estado, periodo)\nVALUES ({{ $json.bomba }}, '{{ $json.quem_manda }}', '{{ $json.motivo }}',\n        '{{ $json.timestamp_estado }}', '{{ $json.periodo }}');\n",
        "options": {}
      },
