  {
    "id": "franking",
    "type": "function",
    "z": "tabaula",
    "name": "ranking dos botoes",
    "func": "// Ranking de quem apertou o botao primeiro.\n// O topico chega como: fiap/iot/2026b/grupo/07/botao  ->  split(\"/\")[4] = \"07\"\nif (msg.topic === \"reset\") {\n    flow.set(\"ranking\", []);\n    return { payload: [] };\n}\n\nlet ranking = flow.get(\"ranking\") || [];\nconst nome = \"Grupo \" + msg.topic.split(\"/\")[4];\n\n// so registra a PRIMEIRA vez que cada grupo aperta\nif (!ranking.some(r => r.grupo === nome)) {\n    ranking.push({\n        pos: ranking.length + 1,\n        grupo: nome,\n        horario: new Date().toLocaleTimeString(\"pt-BR\")\n    });\n    flow.set(\"ranking\", ranking);\n}\n\nreturn { payload: ranking };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 240,
    "wires": [
      [
        "tblranking"
      ]
    ]
  },
