            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_INFLUXDB}"
                      },
                      "spec": {
                        "query": "SELECT time, estimulo\nFROM \"${measurement}\"\nWHERE time >= now() - interval '5 minutes'\nORDER BY time DESC\nLIMIT 1",
                        "rawSql": "SELECT time, estimulo\nFROM \"${measurement}\"\nWHERE time >= now() - interval '5 minutes'\nORDER BY time DESC\nLIMIT 1",
