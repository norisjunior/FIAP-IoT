    {
        "id": "aa132ad8efaa5c13",
        "type": "function",
        "z": "69e5326f76928c61",
        "name": "Somente mudança de estado",
        "func": "const p = msg.payload;\nconst chave = p.device;\nconst anterior = context.get(chave);\ncontext.set(chave, p.estado);\nif (anterior === p.estado) return null;\nif (anterior === undefined && !p.alerta) return null;\nmsg.payload = {...p, timestamp: new Date().toISOString()};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
