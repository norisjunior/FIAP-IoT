  {
    "id": "06d8284feeb5833a",
    "type": "function",
    "z": "69e5326f76928c61",
    "name": "Estado da entrega",
    "func": "const p = msg.payload;\nconst LIMIAR_TEMP = 30;\nconst LIMIAR_UMID = 70;\nconst LIMIAR_DIST = 25;\nconst LIMIAR_INCLINACAO = 45;\n\nlet motivos = [];\nif (![p.temp, p.umid, p.dist, p.inclinacao].every(Number.isFinite)) motivos.push(\"Falha de sensor\");\nif (Number.isFinite(p.temp) && p.temp > LIMIAR_TEMP) motivos.push(\"Temperatura alta\");\nif (Number.isFinite(p.umid) && p.umid > LIMIAR_UMID) motivos.push(\"Umidade alta\");\nif (Number.isFinite(p.dist) && p.dist > LIMIAR_DIST) motivos.push(\"Tampa aberta\");\nif (Number.isFinite(p.inclinacao) && p.inclinacao > LIMIAR_INCLINACAO) motivos.push(\"Caixa inclinada\");\nmsg.payload = {...p, alerta: motivos.length > 0, estado: motivos.join(\" / \") || \"Entrega em condição normal\"};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 540,
    "wires": [
      [
        "927051f96223a544",
        "aa132ad8efaa5c13"
      ]
    ]
