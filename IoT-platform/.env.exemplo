# Configuração da plataforma. Valores de laboratório: revise antes da implantação.
COMPOSE_PROJECT_NAME=iotstack
TZ=America/Sao_Paulo

# Imagens
MOSQUITTO_IMAGE=eclipse-mosquitto:latest
NODERED_IMAGE=norisjunior/nodered-norisiot:latest
POSTGRES_IMAGE=postgres:15
N8N_IMAGE=n8nio/n8n:2.18.4
INFLUXDB_IMAGE=influxdb:2.7
GRAFANA_IMAGE=grafana/grafana:latest

# Portas publicadas no servidor (as portas internas permanecem fixas)
MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
NODERED_PORT=1880
NODERED_EXTRA_PORT=3456
N8N_PORT=5678
INFLUXDB_PORT=8086
GRAFANA_PORT=3000

# Node-RED: usuário admin / senha inicial FIAPIoT.
# Hash bcrypt pronto. Mantenha as aspas simples para preservar os caracteres $.
NODERED_USER=admin
NODERED_PASSWORD_HASH='$2b$10$0D6i/02kzrtHD4uH9Aq8feFIrodshWrpdaz6goa8x0tUYjbRzisYq'

# PostgreSQL do n8n (não é publicado fora da rede Docker)
POSTGRES_DB=n8n
POSTGRES_USER=n8nuser
POSTGRES_PASSWORD=minha_senha_super_secreta

# n8n: no servidor, substitua localhost pelo IP ou domínio acessível aos usuários.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
# Preserve esta chave após gravar credenciais no n8n.
N8N_ENCRYPTION_KEY=XiCegB07AWfY5H7DxNrVrHkUuEe9uUs3
N8N_LOG_LEVEL=info
N8N_RUNNERS_ENABLED=true
N8N_SECURE_COOKIE=false

# InfluxDB: aplicados na primeira inicialização de um volume vazio.
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=FIAP@123
INFLUXDB_ORG=fiapiot
INFLUXDB_BUCKET=sensores
INFLUXDB_RETENTION=30d
INFLUXDB_TOKEN=TOKEN_SUPER_SECRETO_1234567890

# Grafana: conta inicial, criada na primeira inicialização.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
